# ─────────────────────────────────────────────────────────────────
#  Stock Portfolio API — Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Application
APP_NAME="Stock Portfolio & Investment Management API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Security — CHANGE THIS in production!
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/stock_portfolio
DATABASE_ECHO=false

# Market Data
ALPHA_VANTAGE_API_KEY=demo

# CORS (comma-separated or JSON list)
# ALLOWED_ORIGINS=["http://localhost:3000"]
